<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GraderTool.App.Views.Pages.ValidationView">
    <Border Background="{DynamicResource AppBackgroundBrush}">
        <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card" Margin="0,16,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                    <Button Grid.Column="1"
                            Command="{Binding RunValidationCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            Content="Validierung starten"
                            Padding="14,8" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card" Margin="0,16,0,0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="90,180,*,*">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
