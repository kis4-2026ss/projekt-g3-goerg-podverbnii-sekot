<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GraderTool.App.Views.Pages.FetchReposView">
    <Border Background="{DynamicResource AppBackgroundBrush}">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="520,*" Margin="0,16,0,0">
                <Border Classes="card" Grid.Column="0" Margin="0,0,9,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Parameter" FontSize="18" FontWeight="SemiBold" />

                            <TextBlock Text="Assignment-ID" />
                            <TextBox Text="{Binding AssignmentIdText}" Watermark="z. B. 123456" />

                            <TextBlock Text="Hausübungsnummer" />
                            <TextBox Text="{Binding HomeworkNumberText}" Watermark="z. B. 2" />

                            <TextBlock Text="Match-Modus" />
                            <ComboBox ItemsSource="{Binding MatchModes}"
                                      SelectedItem="{Binding MatchBy}"
                                      HorizontalAlignment="Stretch" />

                            <CheckBox IsChecked="{Binding DryRun}" Content="Dry Run verwenden" />

                            <TextBlock Text="Optionale Overrides" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />

                            <TextBlock Text="Grader Root" />
                            <TextBox Text="{Binding GraderRootOverride}" Watermark="Leer lassen = automatisch auflösen" />

                            <TextBlock Text="Students File" />
                            <TextBox Text="{Binding StudentsFileOverride}" Watermark="Leer lassen = automatisch auflösen" />

                            <TextBlock Text="Output Directory" />
                            <TextBox Text="{Binding OutputDirectoryOverride}" Watermark="Leer lassen = grader-root/repos/hueX" />

                            <Border IsVisible="{Binding HasError}"
                                    Background="{DynamicResource DangerBackgroundBrush}"
                                    BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,8,0,0">
                                <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />

                            <ProgressBar IsVisible="{Binding HasProgress}"
                                         Minimum="0"
                                         Maximum="{Binding TotalProgress}"
                                         Value="{Binding CurrentProgress}" />

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button Content="Eingaben prüfen" Command="{Binding ValidateInputsCommand}" />
                                <Button Content="Repos holen" Command="{Binding StartCommand}" />
                                <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                                <Button Content="Log leeren" Command="{Binding ClearLogCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Background="#020617" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="9,0,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Live Log" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   Foreground="#D6DEE8"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
